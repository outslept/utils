{
  "name": "@outslept/utils",
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@10.0.0",
  "description": "Collection of common JavaScript / TypeScript utils",
  "license": "MIT",
  "funding": "https://github.com/sponsors/outslept",
  "repository": {
    "type": "git",
    "url": "https://github.com/outslept/outslept.git"
  },
  "bugs": {
    "url": "https://github.com/outslept/outslept/issues"
  },
  "keywords": [
    "utils"
  ],
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "git clean - dist",
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepare": "simple-git-hooks",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.2.0",
    "@changesets/changelog-git": "^0.2.1",
    "@changesets/changelog-github": "^0.5.1",
    "@changesets/cli": "^2.28.1",
    "@types/node": "^22.13.2",
    "@types/throttle-debounce": "^5.0.2",
    "@vitest/coverage-v8": "^3.0.8",
    "eslint": "^9.20.1",
    "eslint-plugin-format": "^1.0.1",
    "esno": "^4.8.0",
    "nano-staged": "^0.8.0",
    "simple-git-hooks": "^2.11.1",
    "tsdown": "^0.11.4",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm i --frozen-lockfile --ignore-scripts --offline && npx nano-staged"
  },
  "nano-staged": {
    "*": "eslint --fix"
  }
}
